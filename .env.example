# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://openidp:changeme@localhost:5432/openidp

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 ────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=openidp-documents
MINIO_SECURE=false

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OCR Engine ────────────────────────────────────────────────────────
OCR_ENGINE_URL=http://localhost:8001

# ── AWS Bedrock (for Strands Agents) ─────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PROFESSIONAL=price_professional_monthly

# ── OpenTelemetry ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=openidp-api

# ── App ───────────────────────────────────────────────────────────────
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# ── PII Sanitization (platform-wide defaults) ─────────────────────────
# Can be overridden per-tenant via the Settings → PII / Privacy UI.
PII_ENABLED=true
PII_LANGUAGE=en
PII_MIN_SCORE=0.5
# Comma-separated list of Presidio entity types to detect
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,CREDIT_CARD,IBAN_CODE,MEDICAL_LICENSE,DATE_TIME,IP_ADDRESS,URL,NRP

# ── Extraction / AI thresholds (platform-wide defaults) ──────────────
# Can be overridden per-tenant via the Settings → Extraction UI.
EXTRACTION_CONFIDENCE_VALID=0.85
EXTRACTION_CONFIDENCE_REVIEW=0.65
EXTRACTION_CONFIDENCE_FLAG=0.70
EXTRACTION_TEMPERATURE=0.0
EXTRACTION_MAX_TOKENS=4096

# ── Pipeline limits (platform-wide defaults) ──────────────────────────
# Can be overridden per-tenant via the Settings → Pipeline UI.
PIPELINE_MAX_FILE_SIZE_MB=100
PIPELINE_MAX_PAGES=500
PIPELINE_TIMEOUT_SECONDS=120
PIPELINE_OCR_WORKERS=4
